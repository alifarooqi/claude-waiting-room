#!/bin/sh
# wr-launch — open a new tmux pane next to Claude and run a game there.
#
# Usage (from the plugin skill):
#   wr-launch <game-name>
#
# Behavior:
#   - If this process is a tmux pane (self-membership verified): splits
#     a new pane to the right of the current one, sends
#     `waiting-room-<game>` into it, focuses the new pane, exits 0.
#   - If not in tmux: prints a helpful hint to stderr and exits 0.
#   - If the session has zero attached clients: refuses (any new pane
#     would be invisible — better to tell the user).
#   - If the game isn't installed: opens a sibling pane and runs the
#     npm install hint there, exits 0.
#
# Strict POSIX sh. Always exits 0 (Claude hooks must never error Claude).
#
# tmux-presence detection: a previous version of this script tested
# `tmux display-message` as a "is a tmux server reachable" check.
# That's a server-liveness test, not a self-membership test — when run
# from a non-tmux shell while a tmux server happens to be running,
# `display-message` returns the most-recently-active pane of the
# most-recently-active session, and the script takes the in-tmux path
# and splits a pane in an unrelated, unwatched session. That was a
# worse false positive than the original `$TMUX` check it replaced.
#
# The right check is self-membership:
#   1. $TMUX_PANE is set by tmux in every pane it spawns. If set, we
#      know our own pane id without asking the server.
#   2. Verify that pane id still resolves in the local server (it
#      might have been closed if the user detached and the session
#      died). If yes: in tmux, that's our pane.
#   3. As a belt-and-suspenders check for non-tmux shells, walk our
#      own PPID chain and confirm it leads to a tmux server. We don't
#      trust the server-liveness check from a non-tmux context.
#   4. Finally, refuse to target a session with zero attached
#      clients — launching into an unwatched session is never useful.
#
# Result output: a single line of JSON as the LAST line of stdout.
# The skill (or any caller) reads it to know exactly which pane was
# created and which session/window it lives in, so the user can be told
# "look in pane %5 of session wr, window 0" instead of vague prose.
# Human-readable hints go to stderr; machine-readable JSON to stdout,
# so the two never interleave:
#   - ok=true:  game launched; pane/window/session are populated.
#   - ok=false: a human hint went to stderr; reason names why.

set -u

# Helper: emit a JSON result line on stdout (the script's last line).
emit() {
    printf '%s\n' "$1"
}

# Escape a string for inclusion in a JSON string literal (only handles
# the characters POSIX sh printf %s needs to worry about: \ and ").
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

game=$1
if [ -z "$game" ]; then
    printf 'wr-launch: missing game name\n' >&2
    emit "{\"ok\":false,\"reason\":\"missing-arg\"}"
    exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
    printf 'wr-launch: tmux not installed\n' >&2
    emit "{\"ok\":false,\"reason\":\"no-tmux\"}"
    exit 0
fi

# === Self-membership detection ===
#
# tmux sets $TMUX_PANE to the pane id of the calling pane. It's
# inherited by all child processes. If we have a value, the calling
# process is in a tmux pane. Verify it resolves in the local server
# (the pane may have been closed by a `tmux kill-pane` or session
# shutdown).
pane_id=
if [ -n "${TMUX_PANE:-}" ]; then
    if tmux list-panes -a -F '#{pane_id}' 2>/dev/null \
        | grep -qxF "$TMUX_PANE"; then
        pane_id=$TMUX_PANE
    fi
fi
# Belt-and-suspenders: if $TMUX_PANE was unset or didn't resolve, walk
# the PPID chain. We are in tmux iff one of our ancestors is a tmux
# server. This catches the case where tmux didn't propagate $TMUX_PANE.
if [ -z "$pane_id" ]; then
    my_pid=$$
    while [ "$my_pid" -gt 1 ] 2>/dev/null; do
        my_ppid=$(ps -o ppid= -p "$my_pid" 2>/dev/null | tr -d ' ')
        [ -z "$my_ppid" ] && break
        cmd=$(ps -o args= -p "$my_ppid" 2>/dev/null | tr -d ' ' || true)
        case "$cmd" in
            *tmux:server*|*tmux:\"server\"*|*tmux*server*)
                # An ancestor is a tmux server. The current process
                # is therefore inside a tmux-controlled pty even if
                # $TMUX_PANE was unset. We don't have a clean way to
                # learn our own pane id from this, so refuse to
                # split-window (the split target would be guessed
                # and might be the wrong pane). The right action is
                # to ask the user to attach first; we'll print a hint
                # and exit.
                printf 'wr-launch: tmux server is an ancestor but our pane id is unknown. Attach to your session first (e.g. `tmux a -t %s`).\n' "${WR_TMUX_SESSION:-claude-waiting-room}" >&2
                emit "{\"ok\":false,\"reason\":\"unknown-pane\"}"
                exit 0
                ;;
        esac
        my_pid=$my_ppid
    done
fi
if [ -z "$pane_id" ]; then
    # Not in tmux. Surface a hint to the user and let Claude continue.
    cat >&2 <<EOF
wr-launch: not running inside a tmux session.

To use side activities, start Claude inside tmux via the launcher:

    wr

(or manually: tmux new -s wr, then run claude inside it.)

Then in Claude, run /waiting-room:start $game.
EOF
    emit "{\"ok\":false,\"reason\":\"not-in-tmux\"}"
    exit 0
fi

# === We are in tmux; require a real client watching the session ===
#
# Spawning a game pane into a session with zero attached clients is
# never what the user wants — they'd never see it. Detect that and
# refuse. We do this by listing clients of OUR session (the session
# that contains $pane_id). If zero, the user is detached from this
# session.
session_name=$(tmux display-message -p -F '#{session_name}' -t "$pane_id" 2>/dev/null)
window_index=$(tmux display-message -p -F '#{window_index}' -t "$pane_id" 2>/dev/null)
client_count=$(tmux list-clients -t "$session_name" 2>/dev/null | wc -l | tr -d ' ')
if [ "${client_count:-0}" -eq 0 ]; then
    printf 'wr-launch: tmux session "%s" has no attached clients; the new pane would be invisible.\n' "$session_name" >&2
    printf 'wr-launch: from another terminal, run:  tmux attach -t %s\n' "$session_name" >&2
    emit "{\"ok\":false,\"reason\":\"no-clients\",\"session\":\"$session_name\",\"window\":\"$window_index\"}"
    exit 0
fi

# Detect the tmux server socket for explicit -S targeting (so we hit
# the right server, not just the default). The default server IS us if
# we're inside a tmux server, so this is mostly belt-and-suspenders.
tmux_sock=
if [ -n "${TMUX:-}" ]; then
    tmux_sock=${TMUX%%,*}
fi
if [ -z "$tmux_sock" ]; then
    tmux_sock=$(tmux display-message -p -F '#{socket_path}' 2>/dev/null) || tmux_sock=
fi

# Check the game exists on PATH before opening a pane (so the user sees
# the install hint IN the new pane if it's missing, not after a
# confusing flash of a crashed game).
game_esc=$(json_escape "$game")
if ! command -v "waiting-room-$game" >/dev/null 2>&1; then
    # -P -F makes split-window print the NEW pane's id — the only
    # reliable way to know which pane was just created (guessing "the
    # pane that isn't mine" picks the wrong one in sessions that
    # already had 3+ panes).
    new_pane=$(tmux -S "$tmux_sock" split-window -h -t "$pane_id" -P -F '#{pane_id}' 2>/dev/null) || new_pane=
    if [ -n "$new_pane" ]; then
        tmux -S "$tmux_sock" send-keys -t "$new_pane" \
            "printf 'wr-launch: %s is not installed.\\nTry: npm install -g @waiting-room/game-%s\\n' \"$game\" \"$game\"" \
            "C-m" 2>/dev/null || true
        tmux -S "$tmux_sock" select-pane -t "$new_pane" 2>/dev/null || true
    fi
    emit "{\"ok\":false,\"reason\":\"game-not-installed\",\"game\":\"$game_esc\",\"pane\":\"$new_pane\",\"session\":\"$session_name\",\"window\":\"$window_index\"}"
    exit 0
fi

# Open the new pane to the right of the current one. -d avoids the
# automatic focus-shift mid-command; we select-pane explicitly below.
# -P -F prints the new pane's id (see the game-not-installed branch).
new_pane=$(tmux -S "$tmux_sock" split-window -dh -t "$pane_id" -P -F '#{pane_id}' 2>/dev/null) || new_pane=
if [ -z "$new_pane" ]; then
    emit "{\"ok\":false,\"reason\":\"split-failed\",\"pane\":null,\"session\":\"$session_name\",\"window\":\"$window_index\"}"
    exit 0
fi
tmux -S "$tmux_sock" send-keys -t "$new_pane" "waiting-room-$game" C-m 2>/dev/null || true
tmux -S "$tmux_sock" select-pane -t "$new_pane" 2>/dev/null || true

# === Final sanity check: a client is still attached ===
#
# The split and send-keys can both succeed silently; the last thing
# that can go wrong is the user detaching mid-launch. Re-check that
# the session still has an attached client after a tiny delay (keys +
# select need a moment to take effect) so ok:true means "launched into
# a watched session". (Note: this counts the session's clients, not
# focus on the new pane — a client attached to another window of the
# same session still counts. Good enough; focus is the user's to move.)
sleep 0.1
client_count=$(tmux -S "$tmux_sock" list-clients -t "$session_name" 2>/dev/null | wc -l | tr -d ' ')
if [ "${client_count:-0}" -eq 0 ]; then
    emit "{\"ok\":false,\"reason\":\"launch-pending\",\"game\":\"$game_esc\",\"pane\":\"$new_pane\",\"session\":\"$session_name\",\"window\":\"$window_index\"}"
    exit 0
fi
emit "{\"ok\":true,\"game\":\"$game_esc\",\"pane\":\"$new_pane\",\"session\":\"$session_name\",\"window\":\"$window_index\"}"

exit 0
