{
  "description": "Waiting Room plugin hooks — SessionStart auto-attaches Claude inside a tmux session (if not already) and launches the daemon; UserPromptSubmit/Stop/Notification forward lifecycle events as fire-and-forget emits that always exit 0.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/wr-attach",
            "async": true,
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/waiting-room",
            "args": ["daemon"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/waiting-room",
            "args": ["emit", "agent_working"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/waiting-room",
            "args": ["emit", "agent_needs_attention", "--reason", "stop"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/waiting-room",
            "args": ["emit", "agent_needs_attention", "--reason", "notification"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
