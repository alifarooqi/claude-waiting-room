{
  "name": "@waiting-room/sdk",
  "version": "1.0.1",
  "description": "Activity SDK for Waiting Room — pause/resume and focus control for side activities while Claude Code works.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@waiting-room/tsconfig": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
